{
  "multipart": [
    {
      "apply": {
        "model": "caldarium:block/gold_importer_core"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_down"
      },
      "when": {
        "down": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_mouth_down"
      },
      "when": {
        "down": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_up"
      },
      "when": {
        "up": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_mouth_up"
      },
      "when": {
        "up": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_north"
      },
      "when": {
        "north": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_mouth_north"
      },
      "when": {
        "north": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_south"
      },
      "when": {
        "south": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_mouth_south"
      },
      "when": {
        "south": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_west"
      },
      "when": {
        "west": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_mouth_west"
      },
      "when": {
        "west": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_east"
      },
      "when": {
        "east": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/gold_arm_mouth_east"
      },
      "when": {
        "east": "outside"
      }
    }
  ]
}