{
  "multipart": [
    {
      "apply": {
        "model": "caldarium:block/netherite_cable_core"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/netherite_arm_down"
      },
      "when": {
        "down": "along"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/netherite_arm_up"
      },
      "when": {
        "up": "along"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/netherite_arm_north"
      },
      "when": {
        "north": "along"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/netherite_arm_south"
      },
      "when": {
        "south": "along"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/netherite_arm_west"
      },
      "when": {
        "west": "along"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/netherite_arm_east"
      },
      "when": {
        "east": "along"
      }
    }
  ]
}