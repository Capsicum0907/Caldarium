{
  "multipart": [
    {
      "apply": {
        "model": "caldarium:block/iron_exporter_core"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_down"
      },
      "when": {
        "down": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_nozzle_down"
      },
      "when": {
        "down": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_up"
      },
      "when": {
        "up": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_nozzle_up"
      },
      "when": {
        "up": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_north"
      },
      "when": {
        "north": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_nozzle_north"
      },
      "when": {
        "north": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_south"
      },
      "when": {
        "south": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_nozzle_south"
      },
      "when": {
        "south": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_west"
      },
      "when": {
        "west": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_nozzle_west"
      },
      "when": {
        "west": "outside"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_east"
      },
      "when": {
        "east": "line"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/iron_arm_nozzle_east"
      },
      "when": {
        "east": "outside"
      }
    }
  ]
}