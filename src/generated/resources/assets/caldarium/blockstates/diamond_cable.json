{
  "multipart": [
    {
      "apply": {
        "model": "caldarium:block/diamond_cable_core"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/diamond_arm_down"
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/diamond_arm_up"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/diamond_arm_north"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/diamond_arm_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/diamond_arm_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "caldarium:block/diamond_arm_east"
      },
      "when": {
        "east": "true"
      }
    }
  ]
}